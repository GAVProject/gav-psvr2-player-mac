#!/bin/zsh
# Remux HEVC video from the hev1 tag to hvc1.
#
# AVFoundation (and therefore our player and QuickTime) does not decode HEVC
# tagged hev1 — the codec parameters live inside the stream, while Apple
# expects them in the track header. Sign in the player log:
# "hev1 … decodable: NO".
#
# NO transcoding happens: streams are copied as-is, only the tag changes.
# No quality is lost; speed is like copying the file.
#
# Usage:
#   ./fix-hev1 file.mp4 [more files...]
#   ./fix-hev1 /path/to/folder      — recursively all mp4/mov/m4v in the folder
#   ./fix-hev1 -n /path/to/folder   — only show what needs remuxing
#
# A file with the _hvc1 suffix appears next to the original.

set -u

if ! command -v ffmpeg >/dev/null; then
	echo "ffmpeg is required: brew install ffmpeg" >&2
	exit 1
fi

dry_run=0
if [[ "${1:-}" == "-n" ]]; then
	dry_run=1
	shift
fi

if [[ $# -eq 0 ]]; then
	echo "Usage: $0 [-n] <file.mp4 | folder> [...]" >&2
	exit 1
fi

typeset -a files
for arg in "$@"; do
	if [[ -d "$arg" ]]; then
		files+=("$arg"/**/*.(mp4|mov|m4v)(N))
	else
		files+=("$arg")
	fi
done

echo "Files to check: ${#files[@]}"
if (( dry_run )); then
	total=0
	for f in "${files[@]}"; do
		[[ -f "$f" ]] || continue
		tag=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_tag_string \
			-of default=nw=1:nk=1 "$f" 2>/dev/null)
		if [[ "$tag" == "hev1" ]]; then
			size=$(du -h "$f" | cut -f1)
			echo "  needs remuxing ($size): $f"
			(( total++ ))
		fi
	done
	echo "Total hev1: $total"
	exit 0
fi

for f in "${files[@]}"; do
	[[ -f "$f" ]] || continue

	tag=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_tag_string \
		-of default=nw=1:nk=1 "$f" 2>/dev/null)
	if [[ "$tag" != "hev1" ]]; then
		echo "· ${f:t} — tag $tag, no remuxing needed"
		continue
	fi

	out="${f:r}_hvc1.${f:e}"
	if [[ -e "$out" ]]; then
		echo "· ${f:t} — ${out:t} already exists, skipping"
		continue
	fi

	echo "→ ${f:t} → ${out:t}"
	if ffmpeg -v error -stats -i "$f" -map 0 -c copy -tag:v hvc1 \
		-movflags +faststart "$out"; then
		echo "  done"
	else
		echo "  ERROR" >&2
		rm -f "$out"
	fi
done
