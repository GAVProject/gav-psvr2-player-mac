#!/usr/bin/env python3
"""Instant in-place hev1 → hvc1 tag fix (4 bytes).

Why: macOS/AVFoundation does not decode HEVC tagged hev1, even though in many
such files the codec parameters (VPS/SPS/PPS) already sit in the track header
(the hvcC box) — i.e. the content fully matches hvc1 and only the tag is
wrong. In that case no remuxing is needed: patch 4 bytes and the file opens.

The video data is untouched: a single header field changes, so the operation
takes milliseconds even for a 50 GB file sitting on an HDD.

If the header has no parameter sets (rare case), the file is skipped — it
needs a full remux with the fix-hev1 utility.

Usage:
    tag-hvc1 -n <file|folder> ...   show what can be fixed (changing nothing)
    tag-hvc1 <file|folder> ...      fix
    tag-hvc1 -r <file|folder> ...   revert hvc1 → hev1
"""

import os
import struct
import sys

VIDEO_EXT = {".mp4", ".mov", ".m4v"}
CONTAINERS = {b"moov", b"trak", b"mdia", b"minf", b"stbl"}


def find_sample_entries(fh, start, end):
    """stsd entry offsets: [(tag offset, tag, entry offset, size)]."""
    entries = []
    fh.seek(start)
    while fh.tell() < end - 8:
        pos = fh.tell()
        header = fh.read(8)
        if len(header) < 8:
            break
        size, typ = struct.unpack(">I4s", header)
        if size == 1:
            size = struct.unpack(">Q", fh.read(8))[0]
            body = pos + 16
        elif size == 0:
            size = end - pos
            body = pos + 8
        else:
            body = pos + 8
        if size < 8 or pos + size > end:
            break

        if typ in CONTAINERS:
            entries += find_sample_entries(fh, body, pos + size)
        elif typ == b"stsd":
            fh.seek(body + 4)  # version + flags
            count = struct.unpack(">I", fh.read(4))[0]
            for _ in range(count):
                epos = fh.tell()
                if epos + 8 > end:
                    break
                esize, etype = struct.unpack(">I4s", fh.read(8))
                if esize < 8:
                    break
                entries.append((epos + 4, etype, epos, esize))
                fh.seek(epos + esize)
        fh.seek(pos + size)
    return entries


def hvcc_has_parameter_sets(fh, entry_pos, entry_size):
    """Whether the hvcC box contains SPS and PPS parameter sets."""
    fh.seek(entry_pos)
    data = fh.read(entry_size)
    idx = data.find(b"hvcC")
    if idx < 0:
        return False, "no hvcC box"

    box = data[idx + 4:]
    if len(box) < 23:
        return False, "hvcC truncated"

    num_arrays = box[22]
    p = 23
    kinds = set()
    for _ in range(num_arrays):
        if p + 3 > len(box):
            return False, "hvcC corrupted"
        nal_type = box[p] & 0x3F
        count = struct.unpack(">H", box[p + 1:p + 3])[0]
        p += 3
        for _ in range(count):
            if p + 2 > len(box):
                return False, "hvcC corrupted"
            length = struct.unpack(">H", box[p:p + 2])[0]
            p += 2 + length
        if count:
            kinds.add(nal_type)

    if 33 in kinds and 34 in kinds:
        names = {32: "VPS", 33: "SPS", 34: "PPS"}
        return True, ", ".join(names.get(k, str(k)) for k in sorted(kinds))
    return False, "no SPS/PPS in hvcC"


def process(path, dry_run, revert):
    src, dst = (b"hvc1", b"hev1") if revert else (b"hev1", b"hvc1")

    with open(path, "rb") as fh:
        fh.seek(0, os.SEEK_END)
        size = fh.tell()
        try:
            entries = find_sample_entries(fh, 0, size)
        except (struct.error, OSError) as exc:
            print(f"  ! {os.path.basename(path)}: cannot parse ({exc})")
            return 0

        targets = []
        for tag_off, tag, epos, esize in entries:
            if tag != src:
                continue
            ok, detail = hvcc_has_parameter_sets(fh, epos, esize)
            if not ok and not revert:
                print(f"  · {os.path.basename(path)}: {detail} — needs remuxing "
                      f"(tools/fix-hev1)")
                continue
            targets.append((tag_off, detail))

    if not targets:
        return 0

    detail = targets[0][1]
    if dry_run:
        print(f"  → {os.path.basename(path)}: can be fixed ({detail})")
        return len(targets)

    with open(path, "r+b") as fh:
        for tag_off, _ in targets:
            fh.seek(tag_off)
            fh.write(dst)
    print(f"  ✓ {os.path.basename(path)}: {src.decode()} → {dst.decode()} ({detail})")
    return len(targets)


def collect(paths):
    files = []
    for p in paths:
        if os.path.isdir(p):
            for root, _, names in os.walk(p):
                for n in sorted(names):
                    if os.path.splitext(n)[1].lower() in VIDEO_EXT:
                        files.append(os.path.join(root, n))
        elif os.path.isfile(p):
            files.append(p)
    return files


def main():
    args = sys.argv[1:]
    dry_run = "-n" in args
    revert = "-r" in args
    paths = [a for a in args if not a.startswith("-")]

    if not paths:
        print(__doc__)
        return 1

    files = collect(paths)
    print(f"Checking files: {len(files)}")

    fixed = 0
    for path in files:
        try:
            fixed += process(path, dry_run, revert)
        except OSError as exc:
            print(f"  ! {os.path.basename(path)}: {exc}")

    if dry_run:
        print(f"Tracks that can be fixed: {fixed}")
    else:
        print(f"Tracks fixed: {fixed}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
